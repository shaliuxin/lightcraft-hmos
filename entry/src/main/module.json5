{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_description",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:module_description",
        "icon": "$media:app_icon",
        "label": "$string:app_name",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "launchType": "singleton",
        "supportWindowMode": [
          "fullscreen",
          "split",
          "floating"
        ],
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          },
          {
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "file",
                "type": "general.image",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "general.jpeg",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "general.png",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "general.tiff",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "general.gif",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "general.raw-image",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "com.microsoft.bmp",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "com.truevision.tga-image",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "io.github.shaliuxin.lightcraft.hmos.webp",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "io.github.shaliuxin.lightcraft.hmos.heif",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "io.github.shaliuxin.lightcraft.hmos.camera-raw",
                "linkFeature": "FileOpen"
              }
            ]
          }
        ]
      }
    ]
  }
}
